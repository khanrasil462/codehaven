# ==============================================================================
# CodeHaven - .gitignore (Full Stack Python FastAPI + React/Electron)
# ==============================================================================

# --- Dependencies & Virtual Environments ---
node_modules/
frontend/node_modules/
backend/.venv/
.venv/
venv/
env/
ENV/

# --- Python Bytecode & Cache ---
__pycache__/
backend/__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Build Outputs ---
frontend/dist/
frontend/dist-electron/
dist/
dist-electron/
out/
*.tsbuildinfo
frontend/*.tsbuildinfo

# --- Local Databases & Sensitive User Notes ---
# Ensures private chats, uploaded student notes, and vector embeddings stay local
data/
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/notes/
data/codehaven.db
backend/data/notes/
backend/data/codehaven.db

# --- Environment & Credentials ---
.env
.env.*
!.env.example
*.env
*.local

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Logs & Temp ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.tmp
*.temp
scratch/
